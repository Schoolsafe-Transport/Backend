// SchoolSafe Prisma Schema
// Database Engine: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 8 Platform Roles
enum UserRole {
  PARENT
  STUDENT
  SCHOOL_ADMIN
  TRANSPORT_PROVIDER
  DRIVER
  BUSINESS
  ADMIN
  SUPER_ADMIN
}

// Account Lifecycle Statuses
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

// Transportation Request Lifecycle
enum RequestStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Negotiation Offer Lifecycle
enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

// Binding Agreement Statuses
enum AgreementStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  EXPIRED
}

// Payment Transaction Statuses
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// Core User Account Model
model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  phone               String?              @unique
  firstName           String
  lastName            String
  passwordHash        String
  role                UserRole             @default(PARENT)
  status              UserStatus           @default(ACTIVE)
  isVerified          Boolean              @default(false)
  faydaId             String?
  isEmailVerified     Boolean              @default(false)
  emailVerifiedAt     DateTime?
  rejectionReason     String?
  profilePhoto        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  // Marketplace relations
  students            Student[]            @relation("ParentStudents")
  vehicles            Vehicle[]            @relation("ProviderVehicles")
  routes              Route[]              @relation("ProviderRoutes")
  parentRequests      TransportationRequest[] @relation("ParentRequests")
  providerRequests    TransportationRequest[] @relation("ProviderRequests")
  sentOffers          TransportationOffer[]   @relation("SentOffers")
  parentAgreements    TransportationAgreement[] @relation("ParentAgreements")
  providerAgreements  TransportationAgreement[] @relation("ProviderAgreements")
  payerPayments       Payment[]            @relation("PayerPayments")
  receiverPayments    Payment[]            @relation("ReceiverPayments")
  notifications       Notification[]       @relation("UserNotifications")
  ratingsGiven        Rating[]             @relation("ParentRatings")
  ratingsReceived     Rating[]             @relation("ProviderRatings")
  tripsDriven         Trip[]               @relation("DriverTrips")
  reportedIncidents   SafetyIncident[]     @relation("ReportedIncidents")
  businessCampaigns   AdvertisingCampaign[] @relation("BusinessCampaigns")

  @@map("users")
}

// Refresh Token Model with Rotation & Revocation
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_tokens")
}

// Secure Password Reset Token Model
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Secure Email Verification Token Model (Stores SHA-256 Hash of raw token)
model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// Student Model (Child of Parent)
model Student {
  id             String                   @id @default(uuid())
  parentId       String
  parent         User                     @relation("ParentStudents", fields: [parentId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gender         String?
  dateOfBirth    DateTime?
  grade          String?
  schoolName     String
  schoolBranch   String?
  homeAddress    String?
  emergencyPhone String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  requests            TransportationRequest[]
  agreements          TransportationAgreement[]
  authorizedPickups   AuthorizedPickupPerson[]
  tripPassengers      TripPassenger[]
  boardingEvents      BoardingEvent[]

  @@index([parentId])
  @@map("students")
}

// Vehicle Asset Model
model Vehicle {
  id               String                   @id @default(uuid())
  providerId       String
  provider         User                     @relation("ProviderVehicles", fields: [providerId], references: [id], onDelete: Cascade)
  make             String
  model            String
  year             Int?
  plateNumber      String                   @unique
  capacity         Int
  photoUrl         String?
  inspectionExpiry DateTime?
  isVerified       Boolean                  @default(false)
  status           String                   @default("ACTIVE") // ACTIVE, MAINTENANCE
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  routes           Route[]
  agreements       TransportationAgreement[]
  documents        VehicleDocument[]
  trips            Trip[]
  safetyIncidents  SafetyIncident[]

  @@index([providerId])
  @@map("vehicles")
}

// Route Offering Model
model Route {
  id                     String                   @id @default(uuid())
  providerId             String
  provider               User                     @relation("ProviderRoutes", fields: [providerId], references: [id], onDelete: Cascade)
  vehicleId              String
  vehicle                Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name                   String
  origin                 String
  destinationSchool      String
  schoolBranch           String?
  departureTimeMorning   String?
  departureTimeAfternoon String?
  serviceType            String                   @default("BOTH") // MORNING, AFTERNOON, BOTH
  capacity               Int
  availableSeats         Int
  monthlyPrice           Float
  isAcceptingPassengers  Boolean                  @default(true)
  status                 String                   @default("ACTIVE") // ACTIVE, INACTIVE
  completedTrips         Int                      @default(0)
  averageRating          Float                    @default(5.0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  stops                  RouteStop[]
  requests               TransportationRequest[]
  agreements             TransportationAgreement[]
  trips                  Trip[]
  safetyIncidents        SafetyIncident[]

  @@index([providerId])
  @@index([vehicleId])
  @@map("routes")
}

// Route Pickup / Drop-off Stop
model RouteStop {
  id                   String                   @id @default(uuid())
  routeId              String
  route                Route                    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name                 String
  pickupTimeMorning    String?
  dropoffTimeAfternoon String?
  orderIndex           Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  requests             TransportationRequest[]
  agreements           TransportationAgreement[]

  @@index([routeId])
  @@map("route_stops")
}

// Transportation Seat Request
model TransportationRequest {
  id                 String                   @id @default(uuid())
  parentId           String
  parent             User                     @relation("ParentRequests", fields: [parentId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  providerId         String
  provider           User                     @relation("ProviderRequests", fields: [providerId], references: [id], onDelete: Cascade)
  routeId            String
  route              Route                    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupStopId       String?
  pickupStop         RouteStop?               @relation(fields: [pickupStopId], references: [id])
  pickupStopName     String
  preferredStartDate DateTime
  proposedPrice      Float
  currentPrice       Float
  message            String?
  status             RequestStatus            @default(PENDING)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  offers             TransportationOffer[]
  agreement          TransportationAgreement?

  @@index([parentId])
  @@index([providerId])
  @@index([routeId])
  @@index([studentId])
  @@map("transportation_requests")
}

// Immutable Negotiation Offer History
model TransportationOffer {
  id        String                @id @default(uuid())
  requestId String
  request   TransportationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User                  @relation("SentOffers", fields: [senderId], references: [id], onDelete: Cascade)
  amount    Float
  message   String?
  status    OfferStatus           @default(PENDING)
  createdAt DateTime              @default(now())

  @@index([requestId])
  @@index([senderId])
  @@map("transportation_offers")
}

// Binding Transportation Agreement
model TransportationAgreement {
  id             String                @id @default(uuid())
  requestId      String                @unique
  request        TransportationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  parentId       String
  parent         User                  @relation("ParentAgreements", fields: [parentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  providerId     String
  provider       User                  @relation("ProviderAgreements", fields: [providerId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId        String
  route          Route                 @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupStopId   String?
  pickupStop     RouteStop?            @relation(fields: [pickupStopId], references: [id])
  pickupStopName String
  monthlyPrice   Float
  currency       String                @default("ETB")
  startDate      DateTime
  endDate        DateTime?
  status         AgreementStatus       @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  payments       Payment[]

  @@index([parentId])
  @@index([providerId])
  @@index([studentId])
  @@index([routeId])
  @@index([vehicleId])
  @@map("transportation_agreements")
}

// Payment Ledger Record
model Payment {
  id            String                  @id @default(uuid())
  agreementId   String
  agreement     TransportationAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  payerId       String
  payer         User                    @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User                    @relation("ReceiverPayments", fields: [receiverId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String                  @default("ETB")
  status        PaymentStatus           @default(PENDING)
  paymentMethod String                  @default("SIMULATED_TRANSFER")
  reference     String                  @unique
  paidAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([agreementId])
  @@index([payerId])
  @@index([receiverId])
  @@map("payments")
}

// Platform In-App Notification
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// Provider Rating and Review
model Rating {
  id         String   @id @default(uuid())
  providerId String
  provider   User     @relation("ProviderRatings", fields: [providerId], references: [id], onDelete: Cascade)
  parentId   String
  parent     User     @relation("ParentRatings", fields: [parentId], references: [id], onDelete: Cascade)
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([parentId])
  @@map("ratings")
}

// ==========================================
// Trip & Live Transit Execution Models
// ==========================================

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PassengerTripStatus {
  SCHEDULED
  BOARDED
  DROPPED_OFF
  ABSENT
}

enum BoardingEventType {
  BOARDED
  DROPPED_OFF
}

model Trip {
  id             String            @id @default(uuid())
  routeId        String
  route          Route             @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId       String
  driver         User              @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Cascade)
  tripType       String            @default("MORNING") // MORNING, AFTERNOON
  status         TripStatus        @default(SCHEDULED)
  scheduledDate  DateTime          @default(now())
  startTime      DateTime?
  endTime        DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  passengers     TripPassenger[]
  locations      TripLocation[]
  boardingEvents BoardingEvent[]
  incidents      SafetyIncident[]

  @@index([routeId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("trips")
}

model TripPassenger {
  id             String              @id @default(uuid())
  tripId         String
  trip           Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pickupStopName String?
  status         PassengerTripStatus @default(SCHEDULED)
  boardedAt      DateTime?
  droppedOffAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tripId, studentId])
  @@index([tripId])
  @@index([studentId])
  @@map("trip_passengers")
}

model TripLocation {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  speed     Float?   @default(0)
  heading   Float?   @default(0)
  timestamp DateTime @default(now())

  @@index([tripId])
  @@map("trip_locations")
}

model BoardingEvent {
  id             String            @id @default(uuid())
  tripId         String
  trip           Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventType      BoardingEventType
  timestamp      DateTime          @default(now())
  latitude       Float?
  longitude      Float?
  scannedStop    String?
  verifiedByName String?
  notes          String?

  @@index([tripId])
  @@index([studentId])
  @@map("boarding_events")
}

// ==========================================
// Child Safety & Incident Models
// ==========================================

model AuthorizedPickupPerson {
  id                 String   @id @default(uuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName           String
  relationship       String
  phone              String
  idNumber           String?
  photoUrl           String?
  isEmergencyContact Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([studentId])
  @@map("authorized_pickup_persons")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model SafetyIncident {
  id             String           @id @default(uuid())
  reportedById   String
  reportedBy     User             @relation("ReportedIncidents", fields: [reportedById], references: [id], onDelete: Cascade)
  tripId         String?
  trip           Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  routeId        String?
  route          Route?           @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  title          String
  description    String
  severity       IncidentSeverity @default(MEDIUM)
  status         IncidentStatus   @default(OPEN)
  location       String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([reportedById])
  @@index([tripId])
  @@index([routeId])
  @@index([vehicleId])
  @@map("safety_incidents")
}

model VehicleDocument {
  id           String    @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType String    // INSURANCE, INSPECTION, REGISTRATION, COMMERCIAL_PERMIT
  documentUrl  String
  expiryDate   DateTime?
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId])
  @@map("vehicle_documents")
}

// ==========================================
// Advertising Platform Models
// ==========================================

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  COMPLETED
}

model AdvertisingPackage {
  id               String                @id @default(uuid())
  name             String
  description      String
  durationDays     Int
  price            Float
  placement        String                @default("DASHBOARD_AND_LANDING")
  isFeatured       Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  campaigns        AdvertisingCampaign[]

  @@map("advertising_packages")
}

model AdvertisingCampaign {
  id               String               @id @default(uuid())
  businessId       String
  business         User                 @relation("BusinessCampaigns", fields: [businessId], references: [id], onDelete: Cascade)
  packageId        String?
  package          AdvertisingPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  bannerUrl        String
  targetUrl        String?
  placement        String               @default("DASHBOARD_BANNER")
  status           CampaignStatus       @default(PENDING_REVIEW)
  startDate        DateTime?
  endDate          DateTime?
  impressionsCount Int                  @default(0)
  clicksCount      Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  events           AdvertisementEvent[]

  @@index([businessId])
  @@index([packageId])
  @@map("advertising_campaigns")
}

model AdvertisementEvent {
  id         String              @id @default(uuid())
  campaignId String
  campaign   AdvertisingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventType  String              // IMPRESSION, CLICK
  ipHash     String?
  userAgent  String?
  createdAt  DateTime            @default(now())

  @@index([campaignId])
  @@map("advertisement_events")
}

