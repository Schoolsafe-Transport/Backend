# ==========================================
# SchoolSafe Server Environment Variables Template
# ==========================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schoolsafe_db?schema=public

# Security / JWT Authentication Secrets
# Generate random 256-bit keys via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=schoolsafe_development_jwt_access_secret_key_32chars_min
JWT_REFRESH_SECRET=schoolsafe_development_jwt_refresh_secret_key_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Outbound SMTP Email Configuration (Gmail, AWS SES, Postmark, SendGrid)
# For Gmail: Use App Password from Google Account Security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=noreply@schoolsafe.et

# Ethiopian National ID Fayda (Official eSignet OIDC Integration)
FAYDA_CLIENT_ID=
FAYDA_CLIENT_SECRET=
FAYDA_REDIRECT_URI=http://localhost:5000/api/fayda/callback
FAYDA_ISSUER_URL=https://esignet.ida.fayda.et
FAYDA_AUTHORIZE_URL=https://esignet.ida.fayda.et/authorize
FAYDA_TOKEN_URL=https://esignet.ida.fayda.et/v1/esignet/oauth/v2/token
FAYDA_USERINFO_URL=https://esignet.ida.fayda.et/v1/esignet/oidc/userinfo

# Secure File Storage (Relative path works on Windows, Linux, and Docker)
RECEIPTS_STORAGE_DIR=./storage/receipts
