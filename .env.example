PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schoolsafe_db?schema=public

# Security / JWT
JWT_ACCESS_SECRET=schoolsafe_development_jwt_access_secret_key_32chars_min
JWT_REFRESH_SECRET=schoolsafe_development_jwt_refresh_secret_key_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
